<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Добавить гонщика"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Полное имя *"
            android:textStyle="bold"/>
        
        <EditText
            android:id="@+id/editFullName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Введите полное имя"
            android:inputType="textPersonName"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Номер гонщика *"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>
        
        <EditText
            android:id="@+id/editDriverNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Введите номер"
            android:inputType="number"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Имя"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>
        
        <EditText
            android:id="@+id/editFirstName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Введите имя"
            android:inputType="textPersonName"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Фамилия"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>
        
        <EditText
            android:id="@+id/editLastName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Введите фамилию"
            android:inputType="textPersonName"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Команда"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>
        
        <EditText
            android:id="@+id/editTeamName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Введите название команды"
            android:inputType="text"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Цвет команды"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>
        
        <EditText
            android:id="@+id/editTeamColour"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Введите цвет (напр. FF0000)"
            android:inputType="text"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Акроним"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>
        
        <EditText
            android:id="@+id/editNameAcronym"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Введите акроним (напр. VER)"
            android:inputType="textCapCharacters"
            android:maxLength="3"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Код страны"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>
        
        <EditText
            android:id="@+id/editCountryCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Введите код страны (напр. NED)"
            android:inputType="textCapCharacters"
            android:maxLength="3"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Broadcast Name"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>
        
        <EditText
            android:id="@+id/editBroadcastName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Введите broadcast name"
            android:inputType="textPersonName"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp">

            <Button
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Сохранить"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Отмена"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>

