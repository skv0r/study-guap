; Лабораторная работа 1, Вариант 1, Группа 21
; NV=1, NGL=1, NGP=2
; Алгоритм: X3=X1+X2, X9=NOT X9, X6=X6-1

; Инициализация данных в памяти
; X1 = -9 (F7) по адресу 006A
; X2 = 4 (04) по адресу 006B
; X3 = 25 (19) по адресу 006C
; X4 = -1024 (FC00) по адресу 006E
; X5 = 625 (0271) по адресу 0070
; X6 = 6889 (1AE9) по адресу 0072
; X7 = 1048576 (00100000) по адресу 0074
; X8 = -390625 (FFFA0A1F) по адресу 0078
; X9 = 47458321 (02D42811) по адресу 007C

; Промежуточные ячейки (ПЯ) для косвенной адресации
; ПЯ1 (адрес 04CF): 0000006A (адрес X1)
; ПЯ2 (адрес 04D3): 0000006B (адрес X2)

; Инициализация регистров:
; R0 = 000004CF (адрес ПЯ1)
; R1 = 000004D3 (адрес ПЯ2)
; R2 = 0000006C (адрес X3)
; R3 = 00000072 (адрес X6)
; R4 = 0000007C (адрес X9)

; Программа начинается с адреса 03C0
ORG 03C0

; Операция 1: X3 = X1 + X2
ADDB3 @(R0)+,@(R1)+,(R2)  ; Код: C0 90 91 52

; Операция 2: X9 = NOT X9
COML (R4)                  ; Код: D1 54

; Операция 3: X6 = X6 - 1
DECW (R3)                   ; Код: 7A 53

; Останов программы
HALT                        ; Код: 00

; Ожидаемые результаты:
; X3 (006C): FB (-5)
; X6 (0072): 1AE8 (6888)
; X9 (007C): FD2BD7EE (инверсия исходного значения)

