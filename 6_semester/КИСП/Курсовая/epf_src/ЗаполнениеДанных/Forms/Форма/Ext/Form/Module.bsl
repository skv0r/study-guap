&НаКлиенте
Процедура КомандаЗаполнить(Команда)
    ЗаполнитьДанныеНаСервере();
    ПоказатьОповещениеПользователя("Успех", , "Тестовые данные созданы!");
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеНаСервере()
    СпрДолжности = Справочники.Должности;
    
    ДолжАдмин = СпрДолжности.НайтиПоНаименованию("Администратор");
    Если ДолжАдмин.Пустая() Тогда
        НовДолж = СпрДолжности.СоздатьЭлемент();
        НовДолж.Наименование = "Администратор";
        НовДолж.Записать();
        ДолжАдмин = НовДолж.Ссылка;
    КонецЕсли;

    ДолжОпер = СпрДолжности.НайтиПоНаименованию("Оператор");
    Если ДолжОпер.Пустая() Тогда
        НовДолж = СпрДолжности.СоздатьЭлемент();
        НовДолж.Наименование = "Оператор";
        НовДолж.Записать();
        ДолжОпер = НовДолж.Ссылка;
    КонецЕсли;

    СпрСотр = Справочники.Сотрудники;
    Сотр1 = СпрСотр.НайтиПоНаименованию("Иванов И.И.");
    Если Сотр1.Пустая() Тогда
        НовСотр = СпрСотр.СоздатьЭлемент();
        НовСотр.Владелец = ДолжАдмин;
        НовСотр.Наименование = "Иванов И.И.";
        НовСотр.Записать();
    КонецЕсли;
    
    Сотр2 = СпрСотр.НайтиПоНаименованию("Петров П.П.");
    Если Сотр2.Пустая() Тогда
        НовСотр = СпрСотр.СоздатьЭлемент();
        НовСотр.Владелец = ДолжОпер;
        НовСотр.Наименование = "Петров П.П.";
        НовСотр.Записать();
    КонецЕсли;

    СпрТарифы = Справочники.Тарифы;
    Тар1 = СпрТарифы.НайтиПоНаименованию("Дневной");
    Если Тар1.Пустая() Тогда
        НовТар = СпрТарифы.СоздатьЭлемент();
        НовТар.Наименование = "Дневной";
        НовТар.ТипТарифа = "Почасовой";
        НовТар.Цена = 100;
        НовТар.Записать();
    КонецЕсли;

    Тар2 = СпрТарифы.НайтиПоНаименованию("Ночной");
    Если Тар2.Пустая() Тогда
        НовТар = СпрТарифы.СоздатьЭлемент();
        НовТар.Наименование = "Ночной";
        НовТар.ТипТарифа = "Пакет";
        НовТар.Цена = 500;
        НовТар.Записать();
    КонецЕсли;

    СпрКлиенты = Справочники.Клиенты;
    Кл1 = СпрКлиенты.НайтиПоНаименованию("Сидоров С.С.");
    Если Кл1.Пустая() Тогда
        НовКл = СпрКлиенты.СоздатьЭлемент();
        НовКл.Наименование = "Сидоров С.С.";
        НовКл.ФИО = "Сидоров Сергей Степанович";
        НовКл.Телефон = "+79991234567";
        НовКл.Записать();
    КонецЕсли;

    СпрПК = Справочники.Компьютеры;
    ПК1 = СпрПК.НайтиПоНаименованию("ПК-01");
    Если ПК1.Пустая() Тогда
        НовПК = СпрПК.СоздатьЭлемент();
        НовПК.Наименование = "ПК-01";
        НовПК.Категория = "Стандарт";
        НовПК.Характеристики = "Core i5, 16GB, RTX 3060";
        НовПК.Записать();
    КонецЕсли;
    
    ПК2 = СпрПК.НайтиПоНаименованию("ПК-VIP");
    Если ПК2.Пустая() Тогда
        НовПК = СпрПК.СоздатьЭлемент();
        НовПК.Наименование = "ПК-VIP";
        НовПК.Категория = "VIP";
        НовПК.Характеристики = "Core i9, 32GB, RTX 4080";
        НовПК.Записать();
    КонецЕсли;
КонецПроцедуры
