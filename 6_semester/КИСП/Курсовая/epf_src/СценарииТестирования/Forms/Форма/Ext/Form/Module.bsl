&НаКлиенте
Процедура ПриОткрытии(Отказ)
    Если ПараметрЗапуска = "AutoClose" Тогда
        ЗаполнитьСценарииНаСервере();
        ЗавершитьРаботуСистемы(Ложь);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаполнить(Команда)
    ЗаполнитьСценарииНаСервере();
    ПоказатьОповещениеПользователя("Успех", , "Тестовые данные и сценарии успешно сгенерированы!");
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСценарииНаСервере()
    УдалитьСтарыеДанные();

    // 1. Создание Должностей (4 шт)
    СпрДолжности = Справочники.Должности;
    Долж1 = СоздатьДолжность(СпрДолжности, "Администратор");
    Долж2 = СоздатьДолжность(СпрДолжности, "Оператор");
    Долж3 = СоздатьДолжность(СпрДолжности, "Управляющий");
    Долж4 = СоздатьДолжность(СпрДолжности, "Системный администратор");

    // 2. Создание Сотрудников (4 шт)
    СпрСотр = Справочники.Сотрудники;
    Сотр1 = СоздатьСотрудника(СпрСотр, "Иванов И.И.", Долж1);
    Сотр2 = СоздатьСотрудника(СпрСотр, "Петров П.П.", Долж2);
    Сотр3 = СоздатьСотрудника(СпрСотр, "Смирнов С.С.", Долж3);
    Сотр4 = СоздатьСотрудника(СпрСотр, "Кузнецов К.К.", Долж4);

    // 3. Создание Тарифов (4 шт)
    СпрТарифы = Справочники.Тарифы;
    Тар1 = СоздатьТариф(СпрТарифы, "Дневной", "Почасовой", 100);
    Тар2 = СоздатьТариф(СпрТарифы, "Ночной пакет", "Пакет", 500);
    Тар3 = СоздатьТариф(СпрТарифы, "Утренний", "Почасовой", 80);
    Тар4 = СоздатьТариф(СпрТарифы, "VIP Пакет", "Пакет", 1000);

    // 4. Создание Клиентов (4 шт)
    СпрКлиенты = Справочники.Клиенты;
    Кл1 = СоздатьКлиента(СпрКлиенты, "Сидоров С.С.", "+79991234561");
    Кл2 = СоздатьКлиента(СпрКлиенты, "Михайлов М.М.", "+79991234562");
    Кл3 = СоздатьКлиента(СпрКлиенты, "Алексеев А.А.", "+79991234563");
    Кл4 = СоздатьКлиента(СпрКлиенты, "Николаев Н.Н.", "+79991234564");

    // 5. Создание Компьютеров (4 шт)
    СпрПК = Справочники.Компьютеры;
    ПК1 = СоздатьПК(СпрПК, "ПК-01", "Стандарт", "Core i5, 16GB, RTX 3060");
    ПК2 = СоздатьПК(СпрПК, "ПК-02", "Стандарт", "Core i5, 16GB, RTX 3060");
    ПК3 = СоздатьПК(СпрПК, "ПК-VIP1", "VIP", "Core i9, 32GB, RTX 4080");
    ПК4 = СоздатьПК(СпрПК, "ПК-VIP2", "VIP", "Core i9, 32GB, RTX 4090");

    // Заполнение регистра адресации
    НаборАдресации = РегистрыСведений.АдресацияЗадач.СоздатьНаборЗаписей();
    НаборАдресации.Прочитать();
    Если НаборАдресации.Количество() = 0 Тогда
        ДобавитьАдресацию(НаборАдресации, Долж2, Сотр2);
        ДобавитьАдресацию(НаборАдресации, Долж1, Сотр1);
        ДобавитьАдресацию(НаборАдресации, Долж4, Сотр4);
        НаборАдресации.Записать();
    КонецЕсли;

    // Сценарий 1
    Бронь1 = СоздатьБронь(Кл1, ПК1, Тар1, 3600, 7200, 200);
    СоздатьОплату(Кл1, 200);
    СоздатьСеанс(Кл1, ПК1, Тар1, 3600, 7200, 200);
    СоздатьБП(Кл1, ПК1);

    // Сценарий 2
    Бронь2 = СоздатьБронь(Кл2, ПК3, Тар4, 86400, 86400+36000, 1000);
    СоздатьОплату(Кл2, 1000);
    СоздатьСеанс(Кл2, ПК3, Тар4, 86400, 86400+36000, 1000);
    СоздатьБП(Кл2, ПК3);

    // Сценарий 3
    Бронь3 = СоздатьБронь(Кл3, ПК2, Тар3, 10000, 10000+7200, 160);
    СоздатьОплату(Кл3, 160);
    СоздатьСеанс(Кл3, ПК2, Тар3, 10000, 10000+7200, 160);
    СоздатьБП(Кл3, ПК2);

    // Сценарий 4
    Бронь4 = СоздатьБронь(Кл4, ПК4, Тар2, -36000, -36000+14400, 500); // Бронь в прошлом
    СоздатьОплату(Кл4, 500);
    СоздатьСеанс(Кл4, ПК4, Тар2, -36000, -36000+14400, 500);
    СоздатьБП(Кл4, ПК4);

КонецПроцедуры

Функция СоздатьДолжность(Менеджер, Имя)
    Рез = Менеджер.НайтиПоНаименованию(Имя);
    Если Рез.Пустая() Тогда
        Об = Менеджер.СоздатьЭлемент(); Об.Наименование = Имя; Об.Записать(); Рез = Об.Ссылка;
    КонецЕсли;
    Возврат Рез;
КонецФункции

Функция СоздатьСотрудника(Менеджер, Имя, Должность)
    Рез = Менеджер.НайтиПоНаименованию(Имя);
    Если Рез.Пустая() Тогда
        Об = Менеджер.СоздатьЭлемент(); Об.Владелец = Должность; Об.Наименование = Имя; Об.Записать(); Рез = Об.Ссылка;
    КонецЕсли;
    Возврат Рез;
КонецФункции

Функция СоздатьТариф(Менеджер, Имя, Тип, Цена)
    Рез = Менеджер.НайтиПоНаименованию(Имя);
    Если Рез.Пустая() Тогда
        Об = Менеджер.СоздатьЭлемент(); Об.Наименование = Имя; Об.ТипТарифа = Тип; Об.Цена = Цена; Об.Записать(); Рез = Об.Ссылка;
    КонецЕсли;
    Возврат Рез;
КонецФункции

Функция СоздатьКлиента(Менеджер, Имя, Тел)
    Рез = Менеджер.НайтиПоНаименованию(Имя);
    Если Рез.Пустая() Тогда
        Об = Менеджер.СоздатьЭлемент(); Об.Наименование = Имя; Об.ФИО = Имя; Об.Телефон = Тел; Об.Записать(); Рез = Об.Ссылка;
    КонецЕсли;
    Возврат Рез;
КонецФункции

Функция СоздатьПК(Менеджер, Имя, Категория, Харки)
    Рез = Менеджер.НайтиПоНаименованию(Имя);
    Если Рез.Пустая() Тогда
        Об = Менеджер.СоздатьЭлемент(); Об.Наименование = Имя; Об.Категория = Категория; Об.Характеристики = Харки; Об.Записать(); Рез = Об.Ссылка;
    КонецЕсли;
    Возврат Рез;
КонецФункции

Процедура ДобавитьАдресацию(Набор, Должность, Сотрудник)
    Зап = Набор.Добавить();
    Зап.Должность = Должность;
    Зап.Сотрудник = Сотрудник;
КонецПроцедуры

Функция СоздатьБронь(Клиент, ПК, Тариф, СдвигНачало, СдвигКонец, Сумма)
    Заявка = Документы.ЗаявкаНаБронь.СоздатьДокумент();
    Заявка.Дата = ТекущаяДата();
    Заявка.Клиент = Клиент;
    Заявка.Компьютер = ПК;
    Заявка.Тариф = Тариф;
    Заявка.НачалоСеанса = ТекущаяДата() + СдвигНачало;
    Заявка.ОкончаниеСеанса = ТекущаяДата() + СдвигКонец;
    Заявка.Сумма = Сумма;
    Заявка.Записать(РежимЗаписиДокумента.Проведение);
    Возврат Заявка.Ссылка;
КонецФункции

Процедура СоздатьОплату(Клиент, Сумма)
    Оплата = Документы.Оплата.СоздатьДокумент();
    Оплата.Дата = ТекущаяДата();
    Оплата.Клиент = Клиент;
    Оплата.Сумма = Сумма;
    Оплата.Записать(РежимЗаписиДокумента.Проведение);
КонецПроцедуры

Процедура СоздатьСеанс(Клиент, ПК, Тариф, СдвигНачало, СдвигКонец, Сумма)
    Сеанс = Документы.СеансБронирования.СоздатьДокумент();
    Сеанс.Дата = ТекущаяДата() + СдвигНачало;
    Сеанс.Клиент = Клиент;
    Сеанс.Компьютер = ПК;
    Сеанс.Тариф = Тариф;
    Сеанс.НачалоСеанса = ТекущаяДата() + СдвигНачало;
    Сеанс.ОкончаниеСеанса = ТекущаяДата() + СдвигКонец;
    Сеанс.Сумма = Сумма;
    Сеанс.Записать(РежимЗаписиДокумента.Проведение);
КонецПроцедуры

Процедура СоздатьБП(Клиент, ПК)
    БП = БизнесПроцессы.ОбслуживаниеКлиента.СоздатьБизнесПроцесс();
    БП.Дата = ТекущаяДата();
    БП.Клиент = Клиент;
    БП.Компьютер = ПК;
    БП.Записать();
    // БП.Старт(); // Карта маршрута пустая из-за ошибки сохранения, стартуем вручную в предприятии
КонецПроцедуры

Процедура УдалитьСтарыеДанные()
    Доки = Документы.ЗаявкаНаБронь.Выбрать();
    Пока Доки.Следующий() Цикл
        Об = Доки.ПолучитьОбъект(); Об.Удалить();
    КонецЦикла;
    Доки = Документы.Оплата.Выбрать();
    Пока Доки.Следующий() Цикл
        Об = Доки.ПолучитьОбъект(); Об.Удалить();
    КонецЦикла;
    Доки = Документы.СеансБронирования.Выбрать();
    Пока Доки.Следующий() Цикл
        Об = Доки.ПолучитьОбъект(); Об.Удалить();
    КонецЦикла;
    БП = БизнесПроцессы.ОбслуживаниеКлиента.Выбрать();
    Пока БП.Следующий() Цикл
        Об = БП.ПолучитьОбъект(); Об.Удалить();
    КонецЦикла;
    Зад = Задачи.ЗадачаИсполнителя.Выбрать();
    Пока Зад.Следующий() Цикл
        Об = Зад.ПолучитьОбъект(); Об.Удалить();
    КонецЦикла;
    Набор = РегистрыСведений.АдресацияЗадач.СоздатьНаборЗаписей(); Набор.Записать();
    // Регистр ИсторияСтатусовПК подчинен регистратору, его записи удаляются вместе с документами
КонецПроцедуры