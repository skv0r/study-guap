&НаКлиенте
Процедура ТарифПриИзменении(Элемент)
	ПересчитатьСумму();
КонецПроцедуры

&НаКлиенте
Процедура НачалоСеансаПриИзменении(Элемент)
	ПересчитатьСумму();
КонецПроцедуры

&НаКлиенте
Процедура ОкончаниеСеансаПриИзменении(Элемент)
	ПересчитатьСумму();
КонецПроцедуры

&НаСервере
Процедура ПересчитатьСумму()
	Если Не ЗначениеЗаполнено(Объект.Тариф) 
		Или Не ЗначениеЗаполнено(Объект.НачалоСеанса) 
		Или Не ЗначениеЗаполнено(Объект.ОкончаниеСеанса) Тогда
		Возврат;
	КонецЕсли;
	
	ДлительностьСекунды = Объект.ОкончаниеСеанса - Объект.НачалоСеанса;
	Если ДлительностьСекунды <= 0 Тогда
		Объект.Сумма = 0;
		Возврат;
	КонецЕсли;
	
	ДлительностьЧасы = ДлительностьСекунды / 3600;
	
	Цена = Объект.Тариф.Цена;
	ТипТарифа = Объект.Тариф.ТипТарифа;
	
	Если ТипТарифа = "Пакет" Тогда
		Объект.Сумма = Цена; // Фиксированная цена за пакет
	Иначе
		Объект.Сумма = Цена * ДлительностьЧасы; // Почасовая оплата
	КонецЕсли;
КонецПроцедуры
